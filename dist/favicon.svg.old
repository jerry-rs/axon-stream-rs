<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
    <defs>
        <!-- 背景渐变：深邃科技蓝黑 -->
        <linearGradient id="axon-bg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0B0F19" />
            <stop offset="100%" stop-color="#161B33" />
        </linearGradient>

        <!-- 轴突信号渐变：青蓝 -> 紫罗兰 -->
        <linearGradient id="axon-signal" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00F2FE" />
            <stop offset="45%" stop-color="#4FACFE" />
            <stop offset="100%" stop-color="#7F00FF" />
        </linearGradient>

        <!-- 节点辉光效果 -->
        <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="10" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
    </defs>

    <!-- Favicon 圆角底座 -->
    <rect width="512" height="512" rx="112" fill="url(#axon-bg)" />

    <!-- 轴突主线条（形成字母 A 结构） -->
    <!-- 左树突至顶部主轴 */ -->
    <path d="M 155 375 C 155 260, 225 155, 256 120 C 287 155, 357 260, 357 375"
          fill="none"
          stroke="url(#axon-signal)"
          stroke-width="28"
          stroke-linecap="round" />

    <!-- 突触连接横桥 (形成 A 的横杠) -->
    <path d="M 195 295 Q 256 275 317 295"
          fill="none"
          stroke="url(#axon-signal)"
          stroke-width="22"
          stroke-linecap="round" />

    <!-- 节点与电信号 (Nodes & Synapses) -->
    <!-- 1. 顶端主节点 (Soma Cell Body) -->
    <circle cx="256" cy="120" r="28" fill="#00F2FE" filter="url(#glow)" />
    <circle cx="256" cy="120" r="12" fill="#FFFFFF" />

    <!-- 2. 左侧树突末端节点 -->
    <circle cx="155" cy="375" r="20" fill="#00F2FE" />
    <circle cx="155" cy="375" r="8" fill="#FFFFFF" />

    <!-- 3. 右侧轴突末端节点 (Axon Terminal) -->
    <circle cx="357" cy="375" r="22" fill="#7F00FF" filter="url(#glow)" />
    <circle cx="357" cy="375" r="10" fill="#00F2FE" />

    <!-- 4. 横向传输中的电信号脉冲 Particle -->
    <circle cx="256" cy="285" r="10" fill="#FFFFFF" filter="url(#glow)" />
</svg>
